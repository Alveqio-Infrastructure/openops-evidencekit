{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alveqio-infrastructure.github.io/openops-evidencekit/schemas/runtime-report.schema.json",
  "title": "OpenOps Runtime Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "generated_at", "metadata", "summary", "checks", "exited_containers", "restart_policy_missing", "failed_timers"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1(\\.\\d+)?$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "containers_total",
        "containers_running",
        "containers_exited",
        "restart_policy_missing_count",
        "timers_total",
        "timers_active",
        "timers_failed",
        "checks_total",
        "checks_passed",
        "checks_warn",
        "checks_failed"
      ],
      "properties": {
        "status": {
          "enum": ["pass", "warn", "fail"]
        },
        "containers_total": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "containers_running": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "containers_exited": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "restart_policy_missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "timers_total": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "timers_active": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "timers_failed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_total": {
          "type": "integer",
          "minimum": 0
        },
        "checks_passed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_warn": {
          "type": "integer",
          "minimum": 0
        },
        "checks_failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "exited_containers": {
      "$ref": "#/$defs/string_list"
    },
    "restart_policy_missing": {
      "$ref": "#/$defs/string_list"
    },
    "failed_timers": {
      "$ref": "#/$defs/string_list"
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "status", "severity", "path", "reason", "recommended_action"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["pass", "warn", "fail"]
        },
        "severity": {
          "enum": ["critical", "high", "medium", "low"]
        },
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "recommended_action": {
          "type": "string"
        }
      }
    }
  }
}
