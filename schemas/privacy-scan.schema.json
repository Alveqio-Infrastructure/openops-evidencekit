{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alveqio-infrastructure.github.io/openops-evidencekit/schemas/privacy-scan.schema.json",
  "title": "OpenOps Privacy Scan",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "generated_at", "summary", "findings"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1(\\.\\d+)?$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "files_scanned",
        "files_skipped",
        "findings_count",
        "high_count",
        "medium_count",
        "low_count"
      ],
      "properties": {
        "status": {
          "enum": ["pass", "fail"]
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "files_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "findings_count": {
          "type": "integer",
          "minimum": 0
        },
        "high_count": {
          "type": "integer",
          "minimum": 0
        },
        "medium_count": {
          "type": "integer",
          "minimum": 0
        },
        "low_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "line", "kind", "severity", "excerpt"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["high", "medium", "low"]
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
