{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alveqio-infrastructure.github.io/openops-evidencekit/schemas/review-checklist.schema.json",
  "title": "OpenOps Review Checklist",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "generated_at", "metadata", "summary", "items"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1(\\.\\d+)?$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "items_total", "required_items", "pass_count", "warn_count", "fail_count"],
      "properties": {
        "status": {
          "enum": ["pass", "warn", "fail"]
        },
        "items_total": {
          "type": "integer",
          "minimum": 0
        },
        "required_items": {
          "type": "integer",
          "minimum": 0
        },
        "pass_count": {
          "type": "integer",
          "minimum": 0
        },
        "warn_count": {
          "type": "integer",
          "minimum": 0
        },
        "fail_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checklist_item"
      }
    }
  },
  "$defs": {
    "checklist_item": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "status", "required", "artifact", "reason"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["pass", "warn", "fail"]
        },
        "required": {
          "type": "boolean"
        },
        "artifact": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
