{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alveqio-infrastructure.github.io/openops-evidencekit/schemas/report.schema.json",
  "title": "OpenOps Evidence Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "generated_at", "summary", "results"],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "required": ["score", "status", "checks_total", "checks_passed", "checks_failed", "checks_warn"],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "status": {
          "enum": ["pass", "fail"]
        },
        "checks_total": {
          "type": "integer",
          "minimum": 0
        },
        "checks_passed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_failed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_warn": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check_result"
      }
    }
  },
  "$defs": {
    "check_result": {
      "type": "object",
      "required": ["id", "title", "status", "severity", "required", "path", "operator"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["pass", "fail", "warn"]
        },
        "severity": {
          "enum": ["critical", "high", "medium", "low"]
        },
        "required": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "operator": {
          "type": "string"
        }
      }
    }
  }
}
