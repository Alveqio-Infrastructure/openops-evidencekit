{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alveqio-infrastructure.github.io/openops-evidencekit/schemas/report-history.schema.json",
  "title": "OpenOps Report History",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "generated_at", "metadata", "summary", "entries"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1(\\.\\d+)?$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "entries_total",
        "latest_status",
        "latest_score",
        "previous_score",
        "score_change",
        "best_score",
        "worst_score",
        "latest_failed",
        "latest_warnings",
        "failed_delta",
        "warnings_delta"
      ],
      "properties": {
        "entries_total": {
          "type": "integer",
          "minimum": 1
        },
        "latest_status": {
          "enum": ["pass", "fail"]
        },
        "latest_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "previous_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "score_change": {
          "type": "integer"
        },
        "best_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "worst_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "latest_failed": {
          "type": "integer",
          "minimum": 0
        },
        "latest_warnings": {
          "type": "integer",
          "minimum": 0
        },
        "failed_delta": {
          "type": "integer"
        },
        "warnings_delta": {
          "type": "integer"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "recorded_at",
        "report_generated_at",
        "source",
        "note",
        "status",
        "score",
        "checks_total",
        "checks_passed",
        "checks_failed",
        "checks_warn"
      ],
      "properties": {
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "report_generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "status": {
          "enum": ["pass", "fail"]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "checks_total": {
          "type": "integer",
          "minimum": 0
        },
        "checks_passed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_failed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_warn": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
