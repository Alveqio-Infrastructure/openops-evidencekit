{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alveqio-infrastructure.github.io/openops-evidencekit/schemas/monitoring-report.schema.json",
  "title": "OpenOps Monitoring Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "generated_at", "metadata", "summary", "checks", "down_targets"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1(\\.\\d+)?$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["evaluated_at", "max_alert_test_age_days"],
      "properties": {
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "max_alert_test_age_days": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "system",
        "targets",
        "targets_total",
        "targets_up",
        "targets_down",
        "down_targets_count",
        "alert_channels_total",
        "last_alert_test_at",
        "last_alert_test_age_days",
        "checks_total",
        "checks_passed",
        "checks_warn",
        "checks_failed"
      ],
      "properties": {
        "status": {
          "enum": ["pass", "warn", "fail"]
        },
        "system": {
          "type": "string"
        },
        "targets": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "targets_total": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "targets_up": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "targets_down": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "down_targets_count": {
          "type": "integer",
          "minimum": 0
        },
        "alert_channels_total": {
          "type": "integer",
          "minimum": 0
        },
        "last_alert_test_at": {
          "type": "string"
        },
        "last_alert_test_age_days": {
          "type": ["integer", "null"]
        },
        "checks_total": {
          "type": "integer",
          "minimum": 0
        },
        "checks_passed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_warn": {
          "type": "integer",
          "minimum": 0
        },
        "checks_failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title", "status", "severity", "path", "reason", "recommended_action"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["pass", "warn", "fail"]
          },
          "severity": {
            "enum": ["critical", "high", "medium", "low"]
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "recommended_action": {
            "type": "string"
          }
        }
      }
    },
    "down_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["target", "status", "reason"],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
