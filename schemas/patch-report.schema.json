{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alveqio-infrastructure.github.io/openops-evidencekit/schemas/patch-report.schema.json",
  "title": "OpenOps Patch Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "generated_at", "metadata", "summary", "checks", "packages", "security_packages"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1(\\.\\d+)?$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "source", "updates_total", "security_updates_total", "reboot_required", "checks_total", "checks_passed", "checks_warn", "checks_failed"],
      "properties": {
        "status": {
          "enum": ["pass", "warn", "fail"]
        },
        "source": {
          "type": "string"
        },
        "updates_total": {
          "type": "integer",
          "minimum": 0
        },
        "security_updates_total": {
          "type": "integer",
          "minimum": 0
        },
        "reboot_required": {
          "type": ["boolean", "null"]
        },
        "checks_total": {
          "type": "integer",
          "minimum": 0
        },
        "checks_passed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_warn": {
          "type": "integer",
          "minimum": 0
        },
        "checks_failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operational_check"
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "security_packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "operational_check": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "status", "severity", "path", "reason", "recommended_action"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["pass", "warn", "fail"]
        },
        "severity": {
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string"
        },
        "recommended_action": {
          "type": "string"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "current_version", "candidate_version", "architecture", "security"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "suite": {
          "type": "string"
        },
        "current_version": {
          "type": "string"
        },
        "candidate_version": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "security": {
          "type": "boolean"
        }
      }
    }
  }
}
