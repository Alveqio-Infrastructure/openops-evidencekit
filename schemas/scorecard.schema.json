{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alveqio-infrastructure.github.io/openops-evidencekit/schemas/scorecard.schema.json",
  "title": "OpenOps Scorecard",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "generated_at", "metadata", "summary", "domains"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1(\\.\\d+)?$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "source_score",
        "domains_total",
        "domains_passed",
        "domains_failed",
        "domains_warn",
        "checks_total",
        "checks_passed",
        "checks_failed",
        "checks_warn"
      ],
      "properties": {
        "status": {
          "enum": ["pass", "warn", "fail"]
        },
        "source_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "domains_total": {
          "type": "integer",
          "minimum": 0
        },
        "domains_passed": {
          "type": "integer",
          "minimum": 0
        },
        "domains_failed": {
          "type": "integer",
          "minimum": 0
        },
        "domains_warn": {
          "type": "integer",
          "minimum": 0
        },
        "checks_total": {
          "type": "integer",
          "minimum": 0
        },
        "checks_passed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_failed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_warn": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/domain"
      }
    }
  },
  "$defs": {
    "domain": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "domain",
        "title",
        "status",
        "score",
        "checks_total",
        "checks_passed",
        "checks_failed",
        "checks_warn",
        "critical_count",
        "high_count",
        "medium_count",
        "low_count",
        "checks"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["pass", "warn", "fail"]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "checks_total": {
          "type": "integer",
          "minimum": 0
        },
        "checks_passed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_failed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_warn": {
          "type": "integer",
          "minimum": 0
        },
        "critical_count": {
          "type": "integer",
          "minimum": 0
        },
        "high_count": {
          "type": "integer",
          "minimum": 0
        },
        "medium_count": {
          "type": "integer",
          "minimum": 0
        },
        "low_count": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "status", "severity", "required", "path"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["pass", "warn", "fail"]
        },
        "severity": {
          "enum": ["critical", "high", "medium", "low"]
        },
        "required": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        }
      }
    }
  }
}
